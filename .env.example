# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=crm_db
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=change_this_secure_password_123

# Database URL for TypeORM
DATABASE_URL=postgresql://crm_user:change_this_secure_password_123@postgres:5432/crm_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Backend Configuration
BACKEND_PORT=4000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=change_this_to_a_very_secure_random_string_min_32_chars
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change_this_to_another_very_secure_random_string
JWT_REFRESH_EXPIRATION=7d

# Encryption Configuration
# IMPORTANT: Store this securely in production (e.g., HashiCorp Vault)
# This key is used for encrypting PII data (PAN, bank accounts, etc.)
ENCRYPTION_KEY=change_this_to_a_32_byte_hex_string_for_aes256

# SMTP Configuration (MailHog for development)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@benefactor.local

# Twilio Configuration (stub in development, configure for production)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WEBHOOK_SECRET=your_twilio_webhook_secret

# WhatsApp Business API (optional, for future use)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Frontend Configuration
VITE_API_URL=http://localhost/api
VITE_APP_NAME=Benefactor Wealth CRM

# Backup Configuration
BACKUP_GPG_PASSPHRASE=change_this_backup_encryption_password

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
